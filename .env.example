# Copy this file to .env and fill in your own keys
# DO NOT commit the .env file — it is gitignored for security

# Deepgram STT
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# OpenAI / ChatGPT LLM
OPENAI_API_KEY=your_openai_api_key_here

# Fish Audio TTS
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here
# Browse https://fish.audio — find a female voice, copy its ID from the URL
FISH_AUDIO_VOICE_ID=your_voice_model_id_here

# Availity API
AVAILITY_CLIENT_ID=your_availity_client_id_here
AVAILITY_CLIENT_SECRET=your_availity_client_secret_here
